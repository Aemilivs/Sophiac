@page "/settings"

<div class="settings">
    <div class="settings-title">Settings</div>
    <div class="settings-api-provider">
        <div class="settings-api-provider-description">
            LLM Provider
        </div>
        <div class="settings-api-provider-options">
            <InputSelect @bind-Value="_selectedProvider" @oninput="@OnProviderChangeAsync">
                <option value="OpenAI">OpenAI</option>
                <option value="Ollama">Ollama</option>
            </InputSelect>
        </div>
    </div>
    <div class="settings-llm-model">
        <div class="settings-llm-model-description">
            LLM Model
        </div>
        <div class="settings-api-provider-options">
            <InputText @bind-Value="_llmModel" @oninput="@OnLLMModelChangeAsync"></InputText>
        </div>
    </div>
    <div class="settings-openai">
        <div class="settings-openai-key">
            <div class="settings-openai-key-description">
                API Key
            </div>
            <div class="settings-openai-key-input">
                <InputText @bind-Value="_key" @oninput="@OnKeyChangeAsync"></InputText>
            </div>
        </div>
    </div>

    @if (_selectedProvider == "Ollama")
    {
        <div class="settings-ollama-url">
            <div class="settings-ollama-url-description">
                Ollama URL
            </div>
            <div class="settings-ollama-url-input">
                <InputText @bind-Value="_ollamaUrl" @oninput="@OnUrlChangeAsync"></InputText>
            </div>
        </div>
    }

    <div class="settings-advanced-options">
        <div class="settings-advanced-toggle">
            <button @onclick="() => AdvancedOptions = !AdvancedOptions" class="btn btn-secondary">
                @(AdvancedOptions ? "Hide" : "Show") Advanced Options
            </button>
        </div>
        @if (AdvancedOptions)
        {
            <div class="settings-advanced-options-window-size">
                <div class="settings-advanced-options-window-size-title">
                    LLM Window Size
                </div>
                <div class="settings-advanced-options-window-size-description">
                    The size of a window that input text is broken into (in sentences)
                </div>
                <div class="settings-advanced-options-window-size-input">
                    <InputText @bind-Value="_window_size" @oninput="@OnWindowSizeChangeAsync"></InputText>
                </div>
            </div>
            <div class="settings-advanced-options-custom-instructions">
                <div class="settings-advanced-options-custom-instructions-title">
                    Custom Instruction
                </div>
                <div class="settings-advanced-options-custom-instructions-description">
                    A custom instruction that extends the system prompt for the LLM that parses input text.
                </div>
                <div class="settings-advanced-options-custom-instructions-input">
                    <InputText class="wide-input" @bind-Value="_custom_instructions" @oninput="@OnCustomInstructionsChangeAsync"></InputText>
                </div>
            </div>
        }
    </div>

</div>
